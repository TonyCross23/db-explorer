{
  "name": "@db-explorer/shared",
  "version": "0.2.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --outfile=dist/index.mjs --format=esm --platform=neutral"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}
