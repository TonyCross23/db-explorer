# Generate actual secrets with npm run setup. Never use these placeholders.
DB_EXPLORER_TOKEN=replace-with-at-least-32-random-characters
# 32 random bytes encoded as base64. Loss of this key means loss of saved connections.
DB_EXPLORER_MASTER_KEY=replace-with-base64-encoded-32-random-bytes
HOST=127.0.0.1
PORT=4317
# Optional absolute storage and frontend paths:
# DB_EXPLORER_DATA_DIR=/path/to/data
# DB_EXPLORER_STATIC_DIR=/path/to/frontend/dist
# Development only; production UI is served from the same origin:
DB_EXPLORER_ORIGINS=http://127.0.0.1:5173
